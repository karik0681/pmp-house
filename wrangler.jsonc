{
  // Cloudflare: static files after "npm run build", plus a small Worker for /api/*
  "name": "pmp-house",
  "compatibility_date": "2026-11-01",
  // public link https://pmp-house.<account>.workers.dev
  "workers_dev": true,
  // the small server part: it answers /api/* (the assistant demo) and passes everything else to the static files
  "main": "./worker/index.ts",
  // Cloudflare's built-in AI models, used by the assistant demo; no outside key needed
  "ai": { "binding": "AI" },
  // the shared enquiry list (worker/crm.ts); stored in the EU. Passwords and keys are Secrets in the dashboard, never here
  "d1_databases": [{ "binding": "DB", "database_name": "pmp-house-leads", "database_id": "6aa9d864-0d9e-412a-8d17-9d813b2ae9f2" }],
  // keep settings added in the dashboard when a new version is deployed
  "keep_vars": true,
  // e-mail about each new enquiry (worker/crm.ts); goes only to addresses verified in Email Routing
  "send_email": [{ "name": "MAILER" }],
  // where that e-mail goes: the company mailbox (a public address, so it can live here); several = comma-separated
  "vars": { "NOTIFY_EMAIL": "info@pmp-house.cz" },
  // daily clean-up of old enquiries (worker/crm.ts, cleanup), at night Czech time
  "triggers": { "crons": ["17 2 * * *"] },
  // unknown addresses get 404.html (the empty app shell), which then shows the right page or the home page
  "assets": { "directory": "./dist/pmp-house/browser", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] }
}
