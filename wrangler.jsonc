{
  // Cloudflare: the site is plain static files after "npm run build"
  "name": "pmp-house",
  "compatibility_date": "2026-11-01",
  // public link https://pmp-house.<account>.workers.dev
  "workers_dev": true,
  // unknown addresses get 404.html (the empty app shell), which then shows the right page or the home page
  "assets": { "directory": "./dist/pmp-house/browser", "not_found_handling": "404-page" }
}
